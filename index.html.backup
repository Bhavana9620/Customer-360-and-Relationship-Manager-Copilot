<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Ledger — Customer 360 &amp; Relationship Copilot</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet">

<link rel="stylesheet" href="styles.css">
</head>

<body>

<div id="app"></div>

<script>
  window.API_BASE = 'http://localhost:4000/api';

  window.KEYCLOAK_CONFIG = {
    url: 'http://localhost:8080',
    realm: 'customer360',
    clientId: 'customer360-frontend'
  };
</script>

<script src="https://cdn.jsdelivr.net/npm/keycloak-js@26.2.4/dist/keycloak.min.js"></script>

<script src="app.js"></script>

</body>
</html>
